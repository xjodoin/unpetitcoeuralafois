---
import '../../styles/global.css';
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const nav = [
  { label: 'Accueil', href: `${baseUrl}` },
  { label: 'À propos', href: `${baseUrl}#apropos` },
  { label: 'Notre équipe', href: `${baseUrl}#equipe` },
  { label: 'Nos services', href: `${baseUrl}#services` },
  { label: 'Notre engagement', href: `${baseUrl}#engagement` },
  { label: 'Nous joindre', href: `${baseUrl}#contact` }
];

const programs = [
  {
    id: 'mini-recree',
    title: 'Programme Les Mini-Récré'
  },
  {
    id: 'mon-sac-a-mots',
    title: 'Programme Mon sac à mots'
  },
  {
    id: 'yoga-meditation',
    title: 'Yoga et méditation pour les enfants (4-14 ans)'
  }
];
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Soutien en milieu scolaire · Un petit Cœur à la fois</title>
    <meta
      name="description"
      content="Soutien en milieu scolaire et service de garde : programmes Les mini-récrée, Mon sac à mots, yoga et méditation."
    />
  </head>
  <body class="bg-cream text-night">
    <main>
      <section class="relative overflow-hidden bg-hero-wash">
        <div class="absolute inset-0">
          <div class="absolute left-[-12%] top-[-20%] h-[360px] w-[360px] rounded-full bg-blush/40 blur-3xl"></div>
          <div class="absolute right-[-10%] top-[10%] h-[420px] w-[420px] rounded-full bg-clay/40 blur-3xl"></div>
        </div>
        <div class="relative mx-auto max-w-6xl px-6 py-10">
          <header class="flex flex-col items-start justify-between gap-6 rounded-3xl border border-white/40 bg-white/70 px-6 py-6 shadow-soft backdrop-blur md:flex-row md:items-center">
            <div class="flex items-center gap-4">
              <div class="h-14 w-14 overflow-hidden rounded-full border border-ember/20 bg-white">
                <img src={`${baseUrl}assets/logo.jpeg`} alt="Logo Un petit Cœur à la fois" class="h-full w-full object-cover" />
              </div>
              <div>
                <p class="font-display text-xl text-cocoa sm:text-2xl">Un petit Cœur à la fois</p>
                <p class="text-xs uppercase tracking-[0.35em] text-ember/70 sm:text-sm">Allier le cœur et la science</p>
              </div>
            </div>
            <nav class="flex flex-wrap gap-4 text-xs font-medium text-cocoa/80 sm:text-sm">
              {nav.map((item) => (
                <a class="transition hover:text-ember" href={item.href}>{item.label}</a>
              ))}
            </nav>
          </header>

          <div class="mt-10 grid gap-8 md:grid-cols-[1.1fr_0.9fr]">
            <div class="rounded-[32px] border border-white/50 bg-white/75 p-8 shadow-soft">
              <p class="text-xs uppercase tracking-[0.4em] text-ember/70">Soutien en milieu scolaire</p>
              <h1 class="mt-4 font-display text-4xl text-cocoa md:text-5xl">
                Des programmes pour nourrir la sécurité et l’épanouissement des enfants.
              </h1>
              <p class="mt-6 text-lg text-cocoa/80">
                Le soutien en milieu scolaire et en service de garde propose des interventions ciblées pour accompagner
                les enfants dans leur développement socio-émotionnel, langagier et relationnel, en collaboration avec les
                équipes éducatives et les familles.
              </p>
              <p class="mt-4 text-lg text-cocoa/80">
                Les actions s’inscrivent dans une approche préventive et collaborative, fondée sur la science affective
                et adaptée aux réalités de chaque milieu.
              </p>
            </div>
            <div class="rounded-[32px] border border-white/50 bg-white/75 p-8 text-sm text-cocoa/80 shadow-soft">
              <div class="h-56 w-full overflow-hidden rounded-[22px] bg-cream/70">
                <img
                  src={`${baseUrl}assets/soutien-milieu-scolaire.png`}
                  alt="Enfants et intervenante dans un milieu scolaire"
                  class="h-full w-full object-cover"
                />
              </div>
              <p>
                Chaque programme répond à des besoins spécifiques et peut être adapté aux réalités du milieu. Les services
                visent à renforcer les compétences des enfants tout en outillant les intervenants qui les accompagnent au
                quotidien.
              </p>
              <div class="mt-6 rounded-[20px] border border-ember/30 bg-ember/10 px-5 py-4 text-xs uppercase tracking-[0.35em] text-ember/70">
                Collaboration école-famille · Approche préventive
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-cream py-16">
        <div class="mx-auto max-w-5xl px-6">
          <h2 class="section-title font-display text-3xl text-cocoa md:text-4xl">Programmes offerts</h2>
          <p class="mt-4 text-sm text-cocoa/80">
            Sélectionnez un programme pour découvrir les informations disponibles.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {programs.map((program, index) => (
              <button
                type="button"
                data-tab={program.id}
                aria-selected={index === 0 ? 'true' : 'false'}
                class={`tab-button rounded-full border px-5 py-2 text-xs font-semibold uppercase tracking-[0.3em] transition ${
                  index === 0 ? 'bg-ember text-white border-ember shadow-soft' : 'bg-white/80 text-ember/70 border-ember/30'
                }`}
              >
                {program.title}
              </button>
            ))}
          </div>
          <div class="mt-8 rounded-[28px] border border-cocoa/10 bg-white/80 p-6 shadow-soft">
            <div data-panel="mini-recree">
              <h3 class="font-display text-2xl text-cocoa">Programme Les Mini-Récré</h3>
              <p class="mt-4 text-sm text-cocoa/80">
                <strong>Les Mini-Récré</strong> est un programme d'ateliers d'habiletés sociales destiné aux enfants d'âge
                préscolaire et du primaire, offert en petit groupe directement dans les milieux éducatifs. Il vise à soutenir
                le développement des compétences sociales, émotionnelles et relationnelles des enfants, dans un cadre
                sécurisant, ludique et structuré.
              </p>
              <p class="mt-3 text-sm text-cocoa/80">
                À travers le jeu, le mouvement, les échanges et des moments de retour au calme, les enfants sont amenés à
                mieux comprendre leurs émotions, leurs réactions et celles des autres, tout en développant des stratégies
                concrètes pour interagir de façon plus harmonieuse au quotidien.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Une approche douce, relationnelle et respectueuse du rythme de l'enfant</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                Les Mini-Récré reposent sur une approche bienveillante qui reconnaît que chaque enfant évolue à son propre
                rythme. L'objectif n'est pas de corriger des comportements, mais d'<strong>outiller</strong>, de
                <strong>normaliser les difficultés</strong> et de <strong>valoriser les forces</strong> déjà présentes chez l'enfant.
              </p>
              <p class="mt-2 text-sm text-cocoa/80">Le programme s'appuie sur :</p>
              <ul class="mt-2 space-y-2 text-sm text-cocoa/80">
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>un cadre clair et sécurisant ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>des groupes restreints favorisant la participation et le lien ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>une posture adulte contenante, empathique et cohérente ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>l'apprentissage par l'expérience, le jeu et le plaisir.</span></li>
              </ul>

              <h4 class="mt-6 font-display text-lg text-cocoa">Ce que le programme soutient chez l'enfant</h4>
              <p class="mt-2 text-sm text-cocoa/80">Les ateliers Mini-Récré permettent de travailler, entre autres :</p>
              <ul class="mt-2 space-y-2 text-sm text-cocoa/80">
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>la reconnaissance et l'expression des émotions ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>la gestion de l'impulsivité et des émotions intenses ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>la tolérance à la frustration et aux délais ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>l'affirmation de soi dans le respect de l'autre ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>la résolution de conflits et la coopération ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>l'écoute, le respect des règles et le tour de parole ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>le développement de l'estime de soi et du sentiment de compétence.</span></li>
              </ul>
              <p class="mt-3 text-sm text-cocoa/80">
                Les enfants apprennent à mieux se connaître, à comprendre l'impact de leurs gestes et à développer des
                stratégies adaptées à leur réalité.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Une structure d'ateliers claire et progressive</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                Le programme <strong>Les Mini-Récré</strong> se déroule sous forme de <strong>blocs d'ateliers thématiques</strong>,
                généralement offerts une fois par semaine. Chaque atelier comprend :
              </p>
              <ul class="mt-2 space-y-2 text-sm text-cocoa/80">
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>une activité d'ouverture pour favoriser la cohésion du groupe ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>des jeux et activités ciblant une habileté sociale précise ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>des moments d'échanges guidés adaptés à l'âge des enfants ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>une période de retour au calme intégrant respiration, relaxation ou mouvements doux.</span></li>
              </ul>
              <p class="mt-3 text-sm text-cocoa/80">
                Les thèmes abordés évoluent de façon progressive, permettant aux enfants de consolider leurs apprentissages
                d'un atelier à l'autre.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Le rôle central du jeu et du corps</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                Le jeu est au cœur du programme Mini-Récré. Les activités proposées permettent aux enfants de
                <strong>vivre</strong> les situations plutôt que de seulement en parler. Le mouvement, les jeux moteurs et
                les mises en situation facilitent l'intégration des apprentissages et soutiennent la régulation émotionnelle.
              </p>
              <p class="mt-3 text-sm text-cocoa/80">
                Les moments de relaxation et de respiration aident les enfants à développer une meilleure conscience
                corporelle et à découvrir des stratégies concrètes pour se calmer lorsque « ça déborde ».
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Un soutien au développement global et à la vie de groupe</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                Les Mini-Récré contribuent non seulement au développement individuel de chaque enfant, mais aussi à
                l'amélioration du climat de groupe. Les apprentissages réalisés peuvent être réinvestis dans le quotidien
                scolaire ou en milieu de garde, favorisant des interactions plus positives entre les enfants.
              </p>
              <p class="mt-3 text-sm text-cocoa/80">Le programme permet ainsi :</p>
              <ul class="mt-2 space-y-2 text-sm text-cocoa/80">
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>de soutenir les enfants dans leurs défis relationnels ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>de renforcer leur sentiment d'appartenance au groupe ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>de prévenir l'escalade de conflits en outillant les enfants en amont.</span></li>
              </ul>
            </div>

            <div data-panel="mon-sac-a-mots" hidden>
              <h3 class="font-display text-2xl text-cocoa">Programme Mon sac à mots</h3>
              <p class="mt-4 text-sm text-cocoa/80">
                <strong>Mon sac à mots</strong> est un programme de stimulation du langage et du développement global destiné
                aux enfants d'âge préscolaire, offert directement dans les milieux de garde. Il vise à accompagner les enfants
                dans le développement de leurs habiletés langagières, sociales, émotionnelles et cognitives, tout en respectant
                leur rythme et leur unicité.
              </p>
              <p class="mt-3 text-sm text-cocoa/80">
                Plus qu'un programme d'apprentissage, <em>Mon sac à mots</em> propose une approche bienveillante et consciente,
                où l'adulte joue un rôle central comme modèle sécurisant et présent. L'accent est mis autant sur le
                <strong>savoir-être</strong> que sur le <strong>savoir-faire</strong>, puisque la qualité de la relation et de
                la présence de l'adulte influence directement les apprentissages de l'enfant.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Une approche douce, structurée et respectueuse</h4>
              <p class="mt-2 text-sm text-cocoa/80">Le programme repose sur des principes fondamentaux :</p>
              <ul class="mt-2 space-y-2 text-sm text-cocoa/80">
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>respecter le rythme de chaque enfant ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>exposer dans le plaisir, sans exiger de performance ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>valoriser les efforts autant que les réussites ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>favoriser un climat sécurisant, propice aux apprentissages.</span></li>
              </ul>
              <p class="mt-3 text-sm text-cocoa/80">
                Les enfants sont considérés comme des apprenants en développement, et non en évaluation. Chaque activité est
                pensée pour susciter la curiosité, l'engagement et le plaisir d'être en relation.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Ce que le programme soutient chez l'enfant</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                À travers des activités ludiques et structurées, <strong>Mon sac à mots</strong> soutient :
              </p>
              <ul class="mt-2 space-y-2 text-sm text-cocoa/80">
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>le développement du langage oral (vocabulaire, prononciation, structure de phrase, habiletés discursives) ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>l'éveil à la littératie (conscience de l'écrit, vocabulaire littéraire, inférences, conscience phonologique) ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>l'éveil aux mathématiques (comptines numériques, dénombrement, notions spatiales et de grandeur) ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>les fonctions exécutives (attention, concentration, autorégulation) ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>le développement socio-affectif, notamment par la pleine conscience, la respiration et l'apprentissage des règles de communication ;</span></li>
                <li class="flex items-start gap-2"><span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-ember"></span><span>la motricité globale et fine, par des activités de manipulation et de mouvement.</span></li>
              </ul>

              <h4 class="mt-6 font-display text-lg text-cocoa">Les bulles d'éveil : apprendre par l'expérience</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                Le programme est structuré autour de <strong>9 bulles d'éveil</strong>, chacune abordant un thème précis
                (langage oral, sons, lettres, chiffres, musique, rimes, cinq sens, symboles écrits, fête des apprentissages).
                Chaque bulle comprend <strong>quatre activités progressives</strong>, expliquées pas à pas, permettant à
                l'enfant de consolider ses acquis à travers l'expérimentation et la répétition.
              </p>
              <p class="mt-3 text-sm text-cocoa/80">
                Les ateliers peuvent être animés aux <strong>2 à 4 semaines</strong>, selon le rythme du milieu, en laissant
                le temps aux enfants d'explorer et de réinvestir les apprentissages entre les rencontres.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Une place importante accordée à la pleine conscience</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                La pleine conscience fait partie intégrante du programme. Les enfants sont amenés à développer une meilleure
                conscience de leur corps, de leur respiration et de leur état intérieur, afin de favoriser le retour au calme,
                l'attention et la disponibilité aux apprentissages. L'adulte est invité à modéliser cette posture, en prenant
                lui-même un pas de recul et en influençant positivement l'énergie du groupe.
              </p>

              <h4 class="mt-6 font-display text-lg text-cocoa">Préparer la transition scolaire... autrement</h4>
              <p class="mt-2 text-sm text-cocoa/80">
                L'objectif ultime de <strong>Mon sac à mots</strong> est de préparer les enfants à une transition scolaire
                réussie, non seulement en enrichissant leur langage, mais en soutenant l'ensemble des sphères de leur
                développement.
              </p>
              <p class="mt-3 text-sm text-cocoa/80">
                Parce qu'être prêt pour l'école, ce n'est pas seulement connaître des mots, c'est aussi savoir s'exprimer,
                se réguler, interagir avec les autres et se sentir compétent.
              </p>
            </div>

            <div data-panel="yoga-meditation" hidden>
              <h3 class="font-display text-2xl text-cocoa">Yoga et méditation pour les enfants (4-14 ans)</h3>
              <p class="mt-4 text-sm text-cocoa/80">Description à venir.</p>
            </div>
          </div>
          <div class="mt-12 flex flex-wrap gap-4">
            <a
              href={`${baseUrl}services/educatifs/`}
              class="rounded-full bg-ember px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-white shadow-soft transition hover:translate-y-[-2px]"
            >
              Retour aux services éducatifs
            </a>
            <a
              href={`${baseUrl}#services`}
              class="rounded-full border border-ember/40 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-ember transition hover:bg-ember/10"
            >
              Tous les services
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-night py-12 text-cream">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="font-display text-2xl">Un petit Cœur à la fois</p>
          <p class="mt-2 text-sm text-cream/70">
            Allier le cœur et la science pour accompagner chaque histoire avec dignité.
          </p>
        </div>
        <div class="flex flex-wrap gap-6 text-sm text-cream/70">
          {nav.map((item) => (
            <a class="transition hover:text-cream" href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </footer>

    <script is:inline>
      const tabButtons = document.querySelectorAll('[data-tab]');
      const panels = document.querySelectorAll('[data-panel]');
      const activeClasses = ['bg-ember', 'text-white', 'border-ember', 'shadow-soft'];
      const inactiveClasses = ['bg-white/80', 'text-ember/70', 'border-ember/30'];

      const setActiveTab = (id) => {
        tabButtons.forEach((button) => {
          const isActive = button.dataset.tab === id;
          button.setAttribute('aria-selected', isActive ? 'true' : 'false');
          activeClasses.forEach((className) => button.classList.toggle(className, isActive));
          inactiveClasses.forEach((className) => button.classList.toggle(className, !isActive));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== id;
        });
      };

      tabButtons.forEach((button) => {
        button.addEventListener('click', () => setActiveTab(button.dataset.tab));
      });
    </script>
  </body>
</html>
